@using GitCandy.Models
@model GitCandy.Models.RepositoryListModel

@{
    ViewBag.Title = String.Format(SR.Shared_TitleFormat, SR.Repository_ListTitle);
    var hasMore = Model.Repositories != null && Model.Repositories.Length > 0;
}
<div class="row">
    <div class="@(hasMore ? "col-md-8" : "col-md-12")">
        @if ((Model.Collaborations == null || Model.Collaborations.Length == 0) && !hasMore)
        {
            <div class="alert alert-info">@SR.Repository_NoRepositories</div>
        }
        <table class="table border-area">
            @foreach (var repo in Model.Collaborations)
            {
                <tr>
                    <td>
                        <div><h3><a href="~/@repo.Owner/@repo.Name">@repo.FullName</a></h3></div>
                        <div>@repo.Description</div>
                        <div class="row repo-meta">
                            <div class="col-md-6">
                                <span title="@SR.Repository_Views"><i class="glyphicon glyphicon-heart" style="color: deeppink;"></i> @repo.Views.ToString("n0")</span>
                                <span title="@SR.Repository_Commits"><i class="glyphicon glyphicon-star" style="color: mediumpurple;"></i> @repo.Commits.ToString("n0")</span>
                                <span title="@SR.Repository_Contributors"><i class="glyphicon glyphicon-user" style="color: forestgreen;"></i> @repo.Contributors.ToString("n0")</span>
                            </div>
                            <div class="col-md-6 text-right">@(repo.LastCommit.Year < 1000 ? "" : repo.LastCommit.ToFullString())</div>
                        </div>
                    </td>
                </tr>
            }
        </table>
    </div>

    @if (hasMore)
    {
        <div class="col-md-4">
            <table class="table border-area">
                <thead>@SR.Repository_PopularRepositories</thead>
                @foreach (var repo in Model.Repositories)
                {
                    <tr>
                        <td>
                            <div><a href="~/@repo.Owner/@repo.Name">@repo.FullName</a></div>
                            <div>@repo.Description</div>
                            <div class="repo-meta">
                                <div>
                                    <span title="@SR.Repository_Views"><i class="glyphicon glyphicon-heart" style="color: deeppink;"></i> @repo.Views.ToString("n0")</span>
                                    <span title="@SR.Repository_Commits"><i class="glyphicon glyphicon-star" style="color: mediumpurple;"></i> @repo.Commits.ToString("n0")</span>
                                    <span title="@SR.Repository_Contributors"><i class="glyphicon glyphicon-user" style="color: forestgreen;"></i> @repo.Contributors.ToString("n0")</span>
                                </div>
                                <div class="text-right">@(repo.LastCommit.Year < 1000 ? "" : repo.LastCommit.ToFullString())</div>
                            </div>
                        </td>
                    </tr>
                }
            </table>
        </div>
    }
</div>
@await Html.PartialAsync("_Pager")